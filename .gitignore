# --- Secrets -----------------------------------------------------------------
# Never commit real credentials. .env.example carries the variable names only.
.env
.env.local
*.pem
*.key

# --- Python ------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Node / frontend ---------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# --- Runtime artefacts -------------------------------------------------------
# The database is rebuilt from schema.sql + sample_data by `make seed`,
# so it is a build artefact and not source.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/faiss/
data/llm_cache/
data/audio/*.wav
data/audio/*.aiff

# Everything the mock adapters write is generated at runtime and rebuilt by
# `make seed`, so none of it is source. These rules named data/digests/ and
# data/outcome_records/ while the store actually writes under data/documents/,
# so eleven generated files sat in git and changed on every run - including one
# transcript a user had uploaded. The shape a reviewer needs is documented
# instead: the digest layout in docs/components/09-scheduler-digests.md, the
# outcome record in docs/components/10-outcome-records.md, and its schema
# published at docs/outcome_schema.json by `make outcome-schema`.
write_log/*.jsonl
data/documents/
data/uploads/

# --- Model weights -----------------------------------------------------------
# Downloaded on first run by `make setup`. Far too large for git.
#
# Anchored with a leading slash so the rule means "the models directory at the
# repository root" and nothing else. Written as `models/` it matched ANY
# directory of that name at any depth, which silently excluded
# backend/app/models/ - every Pydantic contract in the application - from nine
# commits. A clean clone would not have run.
/models/
/.cache/

# --- OS / editor -------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
claude_skills/
