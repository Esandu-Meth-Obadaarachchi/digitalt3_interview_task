# =============================================================================
# Meeting & Channel Intelligence Agent - environment template
# =============================================================================
# Copy to .env and fill in. .env is gitignored and never committed.
#   cp .env.example .env
# =============================================================================

# --- LLM provider ------------------------------------------------------------
# Which provider the extraction pipeline calls. All providers implement the
# same LLMProvider interface, so this is the only line that changes.
#   gemini  - Google AI Studio free tier (default)
#   ollama  - fully local, no network, no key
#   fake    - deterministic stub used by the test suite, never calls out
LLM_PROVIDER=gemini

# Google AI Studio key. Free tier, no card required: https://aistudio.google.com
# Leave blank if LLM_PROVIDER is not gemini.
#
# The model is pinned to an exact version rather than an alias such as
# gemini-flash-latest, so a committed evaluation result names the model that
# produced it. Google retires versions: gemini-2.0-flash returned 404 during
# this build and was replaced. If that happens, `make check-env` says so.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Local fallback. Requires `ollama serve` running and the model pulled.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Generation settings. Temperature 0 for extraction: we want repeatable
# output, not creative output.
# Free-tier limits. The per-day cap is the binding one: gemini-3.6-flash
# allowed 20 requests a day when this was built, which a single three-run
# evaluation exhausts. The response cache is the documented workaround.
GEMINI_REQUESTS_PER_MINUTE=15
GEMINI_REQUESTS_PER_DAY=20

LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=90

# On-disk cache of model responses, keyed by hash of prompt + model + prompt
# version. Keeps the free tier from being burned on repeated eval runs.
LLM_CACHE_ENABLED=true

# --- Storage -----------------------------------------------------------------
DB_PATH=data/meetings.db
WRITE_LOG_PATH=write_log/tracker_writes.jsonl
DIGEST_OUTPUT_DIR=data/digests
OUTCOME_RECORD_DIR=data/outcome_records

# --- Adapters ----------------------------------------------------------------
# Selects the implementation returned by the adapter factory. Adding a real
# integration means writing one class and changing one value here.
TRACKER_PROVIDER=mock
STORE_PROVIDER=mock
NOTIFIER_PROVIDER=mock

# --- Retrieval ---------------------------------------------------------------
# keyword - SQLite FTS5 / BM25 only
# dense   - FAISS over all-MiniLM-L6-v2 only
# hybrid  - both, fused with Reciprocal Rank Fusion (default)
RETRIEVAL_MODE=hybrid
# minilm runs the model locally. hashing is a deterministic stand-in with no
# model behind it, used by the test suite; it has no notion of meaning, so any
# retrieval number produced with it is meaningless and the harness says so.
EMBEDDING_PROVIDER=minilm
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_DIR=data/faiss
RETRIEVAL_TOP_K=8
RRF_K=60

# --- Chunking ----------------------------------------------------------------
# Chunks are built from whole segments, never split mid-segment, so speaker
# labels and timestamps survive the boundary.
CHUNK_MAX_TOKENS=1200
CHUNK_OVERLAP_TOKENS=200

# --- Approval gate -----------------------------------------------------------
# Safe default for unreviewed items: a pending extraction older than this is
# swept to 'expired' and becomes permanently non-writable.
PENDING_EXPIRY_HOURS=72

# --- Scheduler ---------------------------------------------------------------
# Real APScheduler jobs. Times are local to SCHEDULER_TIMEZONE.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Colombo
DIGEST_HOUR=18
DIGEST_MINUTE=0
EXPIRY_SWEEP_HOUR=2

# --- Audio -------------------------------------------------------------------
# faster-whisper. Smallest model that works: transcription accuracy is not
# what this exercise scores.
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_ENABLED=true

# --- Relative date resolution ------------------------------------------------
# Relative dates in a transcript ("by end of next week") are resolved against
# the meeting date, never against today. The rule is documented in
# docs/architecture.md and tested by golden case 4.
RESOLVE_RELATIVE_DATES=true

# --- Service -----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
